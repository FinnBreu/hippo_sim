<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="base_mass" value="2.655" />
    <xacro:property name="ixx" value="0.007" />
    <xacro:property name="iyy" value="0.028" />
    <xacro:property name="izz" value="0.028" />

    <xacro:property name="thruster_r" value="0.06" />

    <xacro:property name="added_mass_linear" value="1.1 2.8 2.8" />
    <xacro:property name="added_mass_angular" value="0.0018 0.01 0.01"/>
    <xacro:property name="damping_linear" value="4.6 17.4 17.4"/>
    <xacro:property name="damping_angular" value="0.003 0.05 0.05"/>

    <xacro:arg name="use_vertical_camera" default="false" />
    <xacro:property name="vertical_camera_position" value="0.15 0.0 -0.03" />
    <xacro:property name="vertical_camera_orientation" value="0 ${radians(90)} 0" />

    <xacro:arg name="use_acoustic_modem" default="false" />
    <xacro:property name="modem_position" value="0 0 -0.1" />
    <xacro:property name="modem_orientation" value="0 0 0" />
</robot>
